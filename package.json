{
  "name": "new-aeon-cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:migrate": "drizzle-kit migrate",
    "media:migrate": "tsx --env-file=.env scripts/migrate-media-to-s3.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-image": "^2.11.0",
    "@tiptap/extension-link": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/html": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "argon2": "^0.41.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "eslint-config-next": "^15.5.24",
    "jose": "^5.9.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.24",
    "next-intl": "^4.14.0",
    "pg": "^8.13.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sanitize-html": "^2.13.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.13.0",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
