DATABASE_URL="postgresql://postgres:postgres@localhost:5433/new_aeon_cms"
JWT_ACCESS_SECRET="dev-access-secret-min-32-chars-long-ok"
JWT_REFRESH_SECRET="dev-refresh-secret-min-32-chars-different"
ADMIN_PATH="/admin"
NEXT_PUBLIC_ADMIN_PATH="/admin"
DEFAULT_LOCALE="ar"
AVAILABLE_LOCALES="ar,en"
UPLOAD_DIR="./public/uploads"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Storage ---------------------------------------------------------------
# local = ./public/uploads (dev only: files are LOST on every deploy)
# s3    = any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Spaces)
STORAGE_DRIVER="local"

# Required when STORAGE_DRIVER=s3. Boot fails loudly if any is missing.
# S3_BUCKET="new-aeon-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# R2: region stays "auto" and the endpoint is the account URL.
# S3_REGION="auto"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# Public read base - a CDN / r2.dev / custom domain, NOT the API endpoint.
# Must be set at BUILD time as well as runtime: next.config.ts bakes this
# host into the build's image remotePatterns, and next/image rejects any
# host missing from that list.
# S3_PUBLIC_URL="https://media.example.com"
# S3_FORCE_PATH_STYLE="true"

# --- Transactional email ---------------------------------------------------
# log    = writes to .mail-outbox/ and stdout. THE DEFAULT, and the right one
#          for dev: seed data contains real addresses.
# smtp   = any provider (Gmail, Mailgun, SES, Postmark, a client's own server)
# resend = Resend HTTP API
MAIL_DRIVER="log"

# MAIL_FROM="no-reply@newaeon.jo"
# MAIL_FROM_NAME="New Aeon"
# Store-facing alerts. Falls back to settings.contactEmail when unset; set it
# explicitly on staging so a restored production DB cannot mail the real shop.
# MAIL_ADMIN_TO="orders@newaeon.jo"

# SMTP_HOST="smtp.example.com"
# 465 = implicit TLS, 587 = STARTTLS. SMTP_SECURE is inferred from the port.
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""

# RESEND_API_KEY=""

# Deliverability is DNS work, not code: publish SPF and DKIM for the MAIL_FROM
# domain or these messages land in spam regardless of driver.
